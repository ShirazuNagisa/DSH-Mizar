<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Supplemental Info.plist keys.

  This file carries only what cannot be expressed as an INFOPLIST_KEY_ build
  setting, which is anything with a dictionary value. Everything else is
  generated (GENERATE_INFOPLIST_FILE = YES) and merged with these.
-->
<plist version="1.0">
<dict>
	<!--
	  The Mizar transport is a cleartext WebSocket to an address the operator
	  supplies at pairing time: a LAN address or a relay URL. ATS decides
	  at build time which hosts it trusts, and the host here is not knowable in
	  advance, so there is no exception that could name it.

	  The honest fix is TLS on the listener, which is already a planned item; it
	  removes the need for this key entirely. Until then, the traffic's
	  confidentiality comes from the network underneath — WireGuard in the
	  relay case, the local segment in the LAN case.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Required for iOS 14 and later when connecting to a local-network host. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>DSH-Mizar connects to your Mac on the local network to monitor and guide your agent.</string>
	<!--
	  Declared because the app browses for it. iOS raises the local-network
	  permission prompt when an app first *uses* the local network, and a Bonjour
	  browse for an undeclared service type is answered with silence rather than
	  with the prompt -- so the type has to be here for the ask to happen at all.

	  Nothing has to advertise it. The browse exists to raise the question before
	  the operator is halfway through scanning a pairing code, not to find
	  anything: a Mac on the same Wi-Fi is reached at the address in the QR.
	-->
	<key>NSBonjourServices</key>
	<array>
		<string>_mizar._tcp</string>
	</array>
	<!--
	  The pairing URI is mizar://pair?...  Registering the scheme makes the QR
	  payload work as a link as well as as a barcode: an operator who receives it
	  in a message can tap it and be paired, without opening the camera.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>me.shirazu.dshmizar.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mizar</string>
			</array>
		</dict>
	</array>
	<!--
	  The app uses only HTTPS and standard TLS through URLSession, which is exempt
	  from export documentation. Declaring it here answers the export compliance
	  question at upload instead of leaving a build stuck in "Missing Compliance".
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The pairing QR is scanned in-app, so the camera is used only for that. -->
	<key>NSCameraUsageDescription</key>
	<string>Scan the pairing code shown on your Mac.</string>
</dict>
</plist>
