      "body": "eyJkZXZpY2VJZCI6ImRldi0xIn0="
    },
    {
      "t": "ws-open-ok",
      "id": "r3"
    },
    {
      "t": "ws-msg",
      "id": "r3",
      "data": "d29ybGQ=",
      "binary": false
    },
    {
      "t": "ws-close",
      "id": "r3",
      "code": 1000,
      "reason": "done"
    },
    {
      "t": "pong",
      "id": "p1"
    },
    {
      "t": "error",
      "id": "r4",
      "message": "the local listener did not answer"
    }
  ]
