{
  "name": "dsh-mizar",
  "version": "0.9.0",
  "description": "The DSH side of AGI Mizar — forwards raw DSH events and endpoint calls to the desktop app over a loopback link. No listener, no pairing, no relay.",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fake-desktop": "node scripts/fake-desktop.mjs",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-gateway": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-session-projection": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-typert-registry": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-user-approval": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-user-questions": ">=0.2.1-rc.2 <0.2.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "ws": "^8.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShirazuNagisa/DSH-Mizar.git"
  },
  "homepage": "https://github.com/ShirazuNagisa/DSH-Mizar#readme",
  "bugs": {
    "url": "https://github.com/ShirazuNagisa/DSH-Mizar/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "agi-mizar",
    "desktop",
    "agent"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
